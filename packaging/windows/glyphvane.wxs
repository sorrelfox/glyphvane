<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<!-- Copyright (C) 2026 Glyphvane contributors -->
<!--
  Per-user MSI for WiX Toolset v6 (`wix build`), built by
  `cargo xtask package` (format msi), which passes these defines:

    Version       x.y.z (MSI versions are numeric)
    BinDir        directory with glyphvane.exe (and glyphvane-helper.exe)
    IncludeHelper defined when glyphvane-helper.exe is packaged
    LicenseFile   the plain-text licence
    LicenseRtf    the licence as RTF, for the installer's licence page
    NoticesFile   the third-party notices
    IconFile      the application icon (.ico)

  The UpgradeCode must never change: it links every version for upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Glyphvane"
           Manufacturer="Glyphvane contributors"
           Version="$(var.Version)"
           UpgradeCode="E295600A-7134-4179-B72F-04A88A2A9B0F"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Glyphvane is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="GlyphvaneIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="GlyphvaneIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sorrelfox/glyphvane" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Glyphvane" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components use an HKCU value as their key path (ICE38) and
         remove the folders they create (ICE64). -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe">
        <File Id="GlyphvaneExe" Source="$(var.BinDir)\glyphvane.exe" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="MainExe" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>
<?ifdef IncludeHelper?>
      <!-- The helper sits next to the main executable; the app finds it there. -->
      <Component Id="HelperExe">
        <File Id="HelperExe" Source="$(var.BinDir)\glyphvane-helper.exe" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="HelperExe" Type="integer" Value="1" KeyPath="yes" />
      </Component>
<?endif?>
      <Component Id="Documents">
        <File Id="LicenseTxt" Source="$(var.LicenseFile)" Name="LICENSE.txt" />
        <File Id="NoticesTxt" Source="$(var.NoticesFile)" Name="THIRD-PARTY-NOTICES.txt" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="Documents" Type="integer" Value="1" KeyPath="yes" />
      </Component>
      <!-- File associations: a ProgID plus OpenWithProgids, per user (HKCU). Windows
           does not let installers take the default; the user picks Glyphvane in
           Default Apps. -->
      <Component Id="FileAssociations">
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="FileAssociations" Type="integer" Value="1" KeyPath="yes" />
        <RegistryKey Root="HKCU" Key="Software\Classes\Glyphvane.Markdown">
          <RegistryValue Type="string" Value="Markdown document" />
          <RegistryValue Name="AppUserModelID" Type="string" Value="sorrelfox.Glyphvane" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[#GlyphvaneExe]&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[#GlyphvaneExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
        <RegistryValue Root="HKCU" Key="Software\Classes\.md\OpenWithProgids" Name="Glyphvane.Markdown" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="Software\Classes\.markdown\OpenWithProgids" Name="Glyphvane.Markdown" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\glyphvane.exe\SupportedTypes" Name=".md" Type="string" Value="" />
        <RegistryValue Root="HKCU" Key="Software\Classes\Applications\glyphvane.exe\SupportedTypes" Name=".markdown" Type="string" Value="" />
        <!-- Shows Glyphvane in Settings > Default apps. -->
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Capabilities" Name="ApplicationName" Type="string" Value="Glyphvane" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Capabilities" Name="ApplicationDescription" Type="string" Value="Markdown viewer and editor" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Capabilities\FileAssociations" Name=".md" Type="string" Value="Glyphvane.Markdown" />
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Capabilities\FileAssociations" Name=".markdown" Type="string" Value="Glyphvane.Markdown" />
        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="Glyphvane" Type="string" Value="Software\Glyphvane\Capabilities" />
      </Component>
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Glyphvane" Target="[#GlyphvaneExe]" WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="sorrelfox.Glyphvane" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Optional PATH entry (per-user environment); `msiexec ... ADD_TO_PATH=0` skips it. -->
    <Property Id="ADD_TO_PATH" Value="1" />
    <Component Id="PathEntry" Directory="INSTALLFOLDER" Condition="ADD_TO_PATH = 1">
      <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\Glyphvane\Components" Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Glyphvane">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="PathEntry" />
    </Feature>
  </Package>
</Wix>
