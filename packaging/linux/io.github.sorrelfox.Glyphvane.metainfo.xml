  <id>io.github.sorrelfox.Glyphvane</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Glyphvane</name>
  <summary>Read and edit Markdown notes and vaults</summary>
  <description>
    <p>Glyphvane is a native Markdown viewer and editor.</p>
  </description>
  <developer id="io.github.sorrelfox">
    <name>Glyphvane contributors</name>
  </developer>
  <url type="homepage">https://github.com/sorrelfox/glyphvane</url>
  <url type="bugtracker">https://github.com/sorrelfox/glyphvane/issues</url>
  <launchable type="desktop-id">io.github.sorrelfox.Glyphvane.desktop</launchable>
  <provides>
    <binary>glyphvane</binary>
    <mediatype>text/markdown</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <!-- Add an entry for every release, newest first. -->
  <releases>
    <release version="1.0.0" date="2026-11-18">
      <description>
        <p>The first stable release. Glyphvane reads and edits Markdown files
          and folders of notes, with a Reading view, a Source view and a Split
          view, link navigation and link checking across the folder, vault
          search, HTML and PDF export, printing, and read-only Canvas and Bases
          views. Builds for Linux, macOS and Windows are on GitHub Releases.</p>
      </description>
    </release>
